{
	"name": "hive-backend",
	"type": "module",
	"private": true,
	"scripts": {
		"start:dev": "nodemon",
		"start:dev:workers": "node --import tsx ./app/init.workers.ts",
		"start:prod": "node ./dist/server.js",
		"start:prod:workers": "node ./dist/init.workers.js",
		"build": "node --import tsx build.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"seed": "node --import tsx scripts/seed.ts",
		"biome:lint": "npx biome lint --write",
		"biome:format": "npx biome check --write",
		"check:circular": "madge --circular --extensions ts --ts-config tsconfig.json ./src",
		"prepare": "husky"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.0.0",
		"@aws-sdk/client-ses": "^3.0.0",
		"@aws-sdk/client-sesv2": "^3.1099.0",
		"@aws-sdk/s3-request-presigner": "^3.0.0",
		"@bull-board/hono": "^6.0.0",
		"@dotenvx/dotenvx": "^1.0.0",
		"@hono/node-server": "^2.1.1",
		"@hono/zod-validator": "^0.9.0",
		"@node-rs/argon2": "^2.0.0",
		"axios": "^1.19.0",
		"bullmq": "^5.81.0",
		"chalk": "^5.0.0",
		"crypto-js": "^4.0.0",
		"drizzle-orm": "^0.45.0",
		"esbuild": "^0.27.0",
		"google-auth-library": "^11.0.0",
		"googleapis": "^173.0.0",
		"handlebars": "^4.0.0",
		"hono": "^4.12.0",
		"http-status-codes": "^2.0.0",
		"ioredis": "^5.11.0",
		"jsonwebtoken": "^9.0.0",
		"lodash": "^4.18.1",
		"nanoid": "^5.0.0",
		"nodemailer": "^9.0.0",
		"pg": "^8.0.0",
		"puppeteer": "^25.4.0",
		"tsx": "^4.23.0",
		"uuid": "^13.0.0",
		"winston": "^3.0.0",
		"ws": "^8.21.3",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@types/crypto-js": "^4.0.0",
		"@types/jsonwebtoken": "^9.0.0",
		"@types/lodash": "^4.17.24",
		"@types/node": "^24.0.0",
		"@types/nodemailer": "^6.4.0",
		"@types/pg": "^8.0.0",
		"@types/ws": "^8.18.1",
		"drizzle-kit": "^0.31.0",
		"husky": "^9.0.0",
		"madge": "^8.0.0",
		"nodemon": "^3.0.0",
		"vitest": "^4.0.0"
	}
}
