<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Assignment Graded</title>
  <style>
    @media screen {
      @font-face {
        font-family: 'Rency';
        src: url('https://cdn.cowrywise.com/fonts/rency/rency.woff2') format('woff2');
        font-weight: normal;
        font-display: fallback;
      }
      @font-face {
        font-family: 'Rency';
        src: url('https://cdn.cowrywise.com/fonts/rency/rency.woff2') format('woff2');
        font-weight: 600;
        font-display: fallback;
      }
    }
    body {
      margin: 0;
      padding: 0;
      background-color: #f5f3f0;
      font-family: 'Rency', 'Google Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    .email-container {
      max-width: 600px;
      margin: 0 auto;
      background: #ffffff;
      border-radius: 12px;
      border: 1px solid #e8e3db;
    }
    .header {
      padding: 28px 36px 16px;
      border-bottom: 1px solid #f0ece4;
    }
    .logo-svg {
      display: inline-block;
      vertical-align: middle;
      width: 48px;
      height: 48px;
    }
    .content {
      padding: 32px 36px 28px;
    }
    .greeting {
      font-size: 22px;
      font-weight: 500;
      color: #3D3522;
      margin: 0 0 16px;
    }
    .subtext {
      font-size: 14px;
      line-height: 1.8;
      color: #6b6255;
      margin: 0 0 24px;
    }
    .score-badge {
      background: #faf9f7;
      border: 1px solid #e8e3db;
      border-radius: 8px;
      padding: 20px;
      margin: 16px 0;
      text-align: center;
    }
    .score-value {
      font-size: 32px;
      font-weight: 600;
      color: #3D3522;
      line-height: 1.2;
    }
    .score-label {
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      color: #a09888;
      margin-top: 4px;
    }
    .feedback-quote {
      background: #faf9f7;
      border-left: 3px solid #feb307;
      border-radius: 4px;
      padding: 14px 18px;
      margin: 16px 0;
      font-size: 14px;
      line-height: 1.6;
      color: #6b6255;
      font-style: italic;
    }
    .detail-card {
      background: #faf9f7;
      border: 1px solid #e8e3db;
      border-radius: 8px;
      padding: 18px 20px;
      margin: 16px 0;
    }
    .detail-row {
      font-size: 14px;
      color: #3D3522;
      line-height: 1.8;
    }
    .detail-label {
      color: #a09888;
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1px;
    }
    .cta-button {
      display: inline-block;
      background-color: #000000;
      color: #ffffff;
      font-size: 15px;
      font-weight: 500;
      text-decoration: none;
      padding: 14px 40px;
      border-radius: 8px;
      letter-spacing: 0.3px;
      margin: 20px 0 0;
    }
    .footer {
      background: #faf9f7;
      border-top: 1px solid #e8e3db;
      border-radius: 0 0 12px 12px;
      padding: 20px 36px 24px;
      font-size: 12px;
      color: #a09888;
      line-height: 1.6;
    }
    @media (max-width: 480px) {
      .header, .content, .footer {
        padding-left: 20px;
        padding-right: 20px;
      }
    }
  </style>
</head>
<body style="margin:0; padding:0; background-color:#f5f3f0; font-family:'Rency','Google Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;">

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f5f3f0; padding:40px 16px;">
  <tr>
    <td align="center">
      <table role="presentation" class="email-container" cellpadding="0" cellspacing="0" style="max-width:600px; width:100%; background:#ffffff; border-radius:12px; border:1px solid #e8e3db;">
        <!-- HEADER -->
        <tr>
          <td class="header" style="padding:28px 36px 16px; border-bottom:1px solid #f0ece4;">
            <img class="logo-svg" src="https://cdn.tryhive.app/assets/logos/logo.png" width="48" height="48" alt="Hive" style="display:inline-block; vertical-align:middle; border:0;">
          </td>
        </tr>
        <!-- CONTENT -->
        <tr>
          <td class="content" style="padding:32px 36px 28px;">
            <p class="greeting" style="font-size:22px; font-weight:500; color:#3D3522; margin:0 0 16px;">Assignment graded, {{studentName}}!</p>
            <p class="subtext" style="font-size:14px; line-height:1.8; color:#6b6255; margin:0 0 24px;">
              Your submission for <strong>{{lessonName}}</strong> has been graded.
            </p>

            <div class="score-badge" style="background:#faf9f7; border:1px solid #e8e3db; border-radius:8px; padding:20px; margin:16px 0; text-align:center;">
              <div class="score-value" style="font-size:32px; font-weight:600; color:#3D3522; line-height:1.2;">{{score}} / {{maxScore}}</div>
              <div class="score-label" style="font-size:12px; font-weight:600; text-transform:uppercase; letter-spacing:1.5px; color:#a09888; margin-top:4px;">Score</div>
            </div>

            {{#if feedback}}
            <div class="feedback-quote" style="background:#faf9f7; border-left:3px solid #feb307; border-radius:4px; padding:14px 18px; margin:16px 0; font-size:14px; line-height:1.6; color:#6b6255; font-style:italic;">
              {{feedback}}
            </div>
            {{/if}}

            <div style="margin-top:24px;">
              <a href="{{dashboardUrl}}" class="cta-button" style="display:inline-block; background-color:#000000; color:#ffffff; font-size:15px; font-weight:500; text-decoration:none; padding:14px 40px; border-radius:8px; letter-spacing:0.3px;">View feedback</a>
            </div>
          </td>
        </tr>
        <!-- FOOTER -->
        <tr>
          <td class="footer" style="background:#faf9f7; border-top:1px solid #e8e3db; border-radius:0 0 12px 12px; padding:20px 36px 24px; font-size:12px; color:#a09888; line-height:1.6;">
            Learn together, grow together.
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>

</body>
</html>
