<html lang="en"><head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light dark">
  <meta name="supported-color-schemes" content="light dark">
  <title>Reset Your Password - Bloom</title>
</head>
<body style="margin: 0; padding: 0; background-color: #0f0f0f; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; -webkit-font-smoothing: antialiased;">

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #0f0f0f;">
    <tbody><tr>
      <td align="center" style="padding: 40px 16px;">

        <!-- Main Card -->
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width: 480px;">

          <!-- Logo & Brand Header -->
          <tbody><tr>
            <td style="padding: 0 0 32px; text-align: center;">
              <img alt="Bloom" width="70" style="display: inline-block; height: auto; border-radius: 12px;" src="https://trybloomapp.s3.us-east-1.amazonaws.com/assets/mail_logo_2x.png">
            </td>
          </tr>

          <!-- Hero Section -->
          <tr>
            <td style="background: #1a1a1a; border-radius: 16px 16px 0 0; border: 1px solid #2a2a2a; border-bottom: none; padding: 48px 40px 36px; text-align: center;">
              <!-- Greeting -->
              <p style="margin: 0 0 8px; font-size: 14px; color: #DB1D6A; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase;">
                Password Reset Code
              </p>
              <p style="margin: 0 0 32px; font-size: 22px; font-weight: 300; color: #ffffff; line-height: 1.4;">
                Hey {{name}} 👋
              </p>

              <!-- OTP Display -->
              <table role="presentation" cellpadding="0" cellspacing="0" align="center">
                <tbody><tr>
                  <td style="background-color: #DB1D6A; border-radius: 12px; padding: 24px 40px;">
                    <span style="font-size: 36px; font-weight: 800; letter-spacing: 12px; color: #ffffff; font-family: 'SF Mono', SFMono-Regular, Consolas, 'Liberation Mono', Menlo, monospace;">
                      {{otp}}
                    </span>
                  </td>
                </tr>
              </tbody></table>

              <!-- Expiry -->
              <p style="margin: 20px 0 0; font-size: 13px; color: #666666;">
                Expires in <span style="color: #DB1D6A; font-weight: 600;">{{expiryMinutes}} minutes</span>
              </p>
            </td>
          </tr>

          <!-- Message Section -->
          <tr>
            <td style="background: #1a1a1a; border-left: 1px solid #2a2a2a; border-right: 1px solid #2a2a2a; padding: 0 40px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                <tbody><tr>
                  <td style="border-top: 1px solid #2a2a2a; padding: 28px 0;">
                    <p style="margin: 0; font-size: 14px; line-height: 1.7; color: #999999;">
                      We received a request to reset your password. Enter this code to proceed. If you didn't request this, you can safely ignore this email <span style="color: #DB1D6A;">your password will remain unchanged</span>.
                    </p>
                  </td>
                </tr>
              </tbody></table>
            </td>
          </tr>

          <!-- Request Details -->
          <tr>
            <td style="background: #151515; border: 1px solid #2a2a2a; border-radius: 0 0 16px 16px; padding: 24px 40px 28px;">
              <p style="margin: 0 0 16px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: #444444;">
                🛡️ Security Details
              </p>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size: 13px; line-height: 2;">
                <tbody><tr>
                  <td width="90" style="color: #555555; vertical-align: top;">Time</td>
                  <td style="color: #888888;">{{timestamp}}</td>
                </tr>
                <tr>
                  <td width="90" style="color: #555555; vertical-align: top;">IP</td>
                  <td style="color: #888888;">
                    <code style="background: #1e1e1e; padding: 2px 8px; border-radius: 4px; font-size: 12px; font-family: 'SF Mono', SFMono-Regular, Consolas, monospace; color: #DB1D6A; border: 1px solid #2a2a2a;">{{ipAddress}}</code>
                  </td>
                </tr>
                <tr>
                  <td width="90" style="color: #555555; vertical-align: top;">Location</td>
                  <td style="color: #888888;">{{location}}</td>
                </tr>
                <tr>
                  <td width="90" style="color: #555555; vertical-align: top;">Device</td>
                  <td style="color: #888888;">{{device}}</td>
                </tr>
              </tbody></table>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding: 32px 40px; text-align: center;">
              <p style="margin: 0 0 8px; font-size: 12px; color: #444444;">
                © 2026 Bloom · All rights reserved
              </p>
              <p style="margin: 0; font-size: 11px; color: #333333;">
                You received this because a password reset was requested for your account.
              </p>
            </td>
          </tr>

        </tbody></table>

      </td>
    </tr>
  </tbody></table>


</body></html>
