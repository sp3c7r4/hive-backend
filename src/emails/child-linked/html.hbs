              <path d="M113.82,105.39c18.41,1.08,31.29,10.78,39.52,26.5,11.62,22.33,11,44.76-3.77,65.6-15.79,22.16-45.81,24.27-65.27,5.43-24.4-23.58-24.4-65.52-.09-86.86A38.93,38.93,0,0,1,113.82,105.39Zm28.94,58.25c0-12.53-3.68-22.85-12.79-30.53a25.9,25.9,0,0,0-36.61,2l-.28.34c-9.45,10.36-11.49,26.66-5.17,40.2,5.59,12.2,17,19.67,28.68,18.67s21.5-10.29,24.92-23.42a73.79,73.79,0,0,0,1.25-7.3Z" fill="#fefefe"/>
              <path d="M276.14,168.62a50.06,50.06,0,0,1-1,6.66c-3.84,15.51-16.61,25.37-30.35,23.88S219.08,184,218.16,167.79a37.24,37.24,0,0,1,6-23.52c10.81-16.26,32-17.3,44.29-1.91C274,149.54,276.48,157.94,276.14,168.62Zm-10.6-16c.41-8-5.05-15.06-12-15.56s-12.38,5.28-12.8,13.15c-.38,8.32,5.23,15.36,12.6,15.51C260,165.93,265.25,160.16,265.54,152.62Zm-.72,24.48a4.9,4.9,0,0,0,4.73-5.1h0c0-3.14-1.26-5.53-4.42-5.88s-4.84,2-4.87,5.27a5.34,5.34,0,0,0,4.56,5.71Z" fill="#050403"/>
              <path d="M142.91,163.62c-.3,1.91-.7,4.6-1.4,7.32-3.42,13.13-13.28,22.27-24.92,23.42S93.67,188,87.91,175.69c-6.32-13.54-4.12-29.85,5.17-40.2a25.89,25.89,0,0,1,36.55-2.66l.34.28C139.23,140.77,142.78,151.11,142.91,163.62Zm-12.18-16.17c.25-8-5.2-15-12.12-15.4-6.76-.36-12.34,5.76-12.62,13.45-.26,8,5.2,15.05,12.27,15.38s12.2-5.58,12.47-13.43ZM129.85,161c-3.22.75-4.77,2.76-4.5,5.87s1.87,5.47,5.29,5.18c3-.25,4.32-2.56,4.24-5.37a5.34,5.34,0,0,0-5-5.68Z" fill="#050403"/>
