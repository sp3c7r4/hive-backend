              <path d="M130.73,147.45c-.27,7.85-5.71,13.79-12.62,13.45s-12.52-7.23-12.28-15.39c.28-7.69,5.86-13.8,12.62-13.44C125.53,132.4,131,139.29,130.73,147.45Z" fill="#fefefe"/>
              <path d="M129.84,160.83a5.31,5.31,0,0,1,4.87,5.69h0c.08,2.81-1.13,5.1-4.24,5.37-3.41.29-4.88-2.24-5.29-5.18S126.62,161.57,129.84,160.83Z" fill="#fefefe"/>
              <path d="M261.85,92.28a73,73,0,0,0-75.13,66.22c-1.5.67-6.08.26-6.95-.36-1-38-30.8-69.49-68.5-70.91a72.4,72.4,0,0,0-5.5,144.69c36.94,1.26,69-26.68,73.47-63.11a28.28,28.28,0,0,1,7.24,0c1.69,37.19,28.37,67.94,65.88,69.33,39.89,1.47,76.56-29.6,78.2-69.52C332.35,128.18,301.59,93.94,261.85,92.28Zm-91.16,70c-1.28,34.39-30.57,61.61-64.62,60.46a63.25,63.25,0,0,1,4.81-126.41C145.11,97.66,171.91,127.31,170.69,162.32Zm150.2,5.88a62.57,62.57,0,0,1-64.79,60.18c-34.39-1.28-61.52-31-60-65.76a63.17,63.17,0,0,1,65.25-60.54C295.8,103.51,322.44,133.16,320.89,168.2Z" fill="#050403"/>
            </svg>
          </td>
        </tr>

        <!-- CONTENT -->
        <tr>
          <td class="content" style="padding:32px 36px 28px;">

            <p class="badge" style="font-size:11px; font-weight:600; color:#a09888; letter-spacing:1.5px; text-transform:uppercase; margin:0 0 4px;">
              {{#if isActive}}Link confirmed{{else}}Invite sent{{/if}}
            </p>

            <p class="greeting" style="font-size:20px; font-weight:400; color:#3D3522; margin:0 0 16px; line-height:1.4;">
              Hello {{parentName}}
            </p>

            <p class="message" style="font-size:14px; line-height:1.8; color:#6b6255; margin:0 0 24px;">
              {{#if isActive}}
                Your child <strong style="color:#3D3522;">{{childName}}</strong> has been linked to your account. You can now monitor their progress, enrolled courses, and learning activity from your dashboard.
              {{else}}
                An invitation has been sent to <strong style="color:#3D3522;">{{childEmail}}</strong>. Once they create their Hive account, the link will activate automatically and you will be able to monitor their progress.
              {{/if}}
            </p>

            <!-- Details -->
            <div class="details" style="border-top:1px solid #f0ece4; padding-top:24px; margin-top:24px;">
              {{#if isActive}}
                <div class="detail-row" style="margin-bottom:16px;">
                  <p class="detail-label" style="font-size:13px; color:#a09888; margin:0 0 4px;">Child</p>
                  <p class="detail-value" style="font-size:15px; color:#3D3522; font-weight:500; margin:0;">
                    {{childName}} · {{childEmail}}
                  </p>
                </div>
                <div class="detail-row" style="margin-bottom:0;">
                  <p class="detail-label" style="font-size:13px; color:#a09888; margin:0 0 4px;">Linked on</p>
                  <p class="detail-value" style="font-size:15px; color:#3D3522; font-weight:500; margin:0;">
                    {{linkedAt}}
                  </p>
                </div>
              {{else}}
                <div class="detail-row" style="margin-bottom:16px;">
                  <p class="detail-label" style="font-size:13px; color:#a09888; margin:0 0 4px;">Invited email</p>
                  <p class="detail-value" style="font-size:15px; color:#3D3522; font-weight:500; margin:0;">
                    {{childEmail}}
                  </p>
                </div>
                <div class="detail-row" style="margin-bottom:0;">
                  <p class="detail-label" style="font-size:13px; color:#a09888; margin:0 0 4px;">Status</p>
                  <p class="detail-value pending" style="font-size:15px; color:#a09888; font-weight:500; margin:0;">
                    Pending – waiting for {{childEmail}} to join
                  </p>
                </div>
              {{/if}}
            </div>

            <!-- CTA -->
            <div class="cta-wrapper" style="margin-top:28px;">
              <a href="{{dashboardUrl}}" class="cta-button" style="display:inline-block; background-color:#000000; color:#ffffff; font-size:15px; font-weight:500; text-decoration:none; padding:14px 40px; border-radius:8px; letter-spacing:0.3px;">
                View dashboard
              </a>
            </div>

          </td>
        </tr>

        <!-- FOOTER -->
        <tr>
          <td class="footer" style="background:#faf9f7; border-top:1px solid #e8e3db; border-radius:0 0 12px 12px; padding:20px 36px 24px; font-size:12px; color:#a09888; line-height:1.6; text-align:left;">
            Learn together, grow together.
          </td>
        </tr>

      </table>
    </td>
  </tr>
</table>

</body>
</html>
