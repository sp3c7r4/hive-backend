<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Child linked</title>
  <style>
    @media screen {
      @font-face {
        font-family: 'Rency';
        src: url('https://cdn.cowrywise.com/fonts/rency/rency.woff2') format('woff2');
        font-weight: normal;
        font-display: fallback;
      }
      @font-face {
        font-family: 'Rency';
        src: url('https://cdn.cowrywise.com/fonts/rency/rency.woff2') format('woff2');
        font-weight: 600;
        font-display: fallback;
      }
    }
    body {
      margin: 0;
      padding: 0;
      background-color: #f5f3f0;
      font-family: 'Rency', 'Google Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    .email-container {
      max-width: 600px;
      margin: 0 auto;
      background: #ffffff;
      border-radius: 12px;
      border: 1px solid #e8e3db;
    }
    .header {
      padding: 28px 36px 16px;
      border-bottom: 1px solid #f0ece4;
    }
    .logo-svg {
      display: inline-block;
      vertical-align: middle;
      width: 48px;
      height: 48px;
    }
    .content {
      padding: 32px 36px 28px;
    }
    .badge {
      font-size: 11px;
      font-weight: 600;
      color: #a09888;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      margin: 0 0 4px;
    }
    .greeting {
      font-size: 20px;
      font-weight: 400;
      color: #3D3522;
      margin: 0 0 16px;
      line-height: 1.4;
    }
    .message {
      font-size: 14px;
      line-height: 1.8;
      color: #6b6255;
      margin: 0 0 24px;
    }
    .message strong {
      color: #3D3522;
    }
    .details {
      border-top: 1px solid #f0ece4;
      padding-top: 24px;
      margin-top: 24px;
    }
    .detail-row {
      margin-bottom: 16px;
    }
    .detail-label {
      font-size: 13px;
      color: #a09888;
      margin: 0 0 4px;
    }
    .detail-value {
      font-size: 15px;
      color: #3D3522;
      font-weight: 500;
      margin: 0;
    }
    .detail-value.pending {
      color: #a09888;
    }
    .detail-value .status-pending {
      color: #a09888;
    }
    .cta-wrapper {
      margin-top: 28px;
    }
    .cta-button {
      display: inline-block;
      background-color: #000000;
      color: #ffffff;
      font-size: 15px;
      font-weight: 500;
      text-decoration: none;
      padding: 14px 40px;
      border-radius: 8px;
      letter-spacing: 0.3px;
    }
    .footer {
      background: #faf9f7;
      border-top: 1px solid #e8e3db;
      border-radius: 0 0 12px 12px;
      padding: 20px 36px 24px;
      font-size: 12px;
      color: #a09888;
      line-height: 1.6;
      text-align: left;
    }
    @media (max-width: 480px) {
      .header, .content, .footer {
        padding-left: 20px;
        padding-right: 20px;
      }
    }
  </style>
</head>
<body style="margin:0; padding:0; background-color:#f5f3f0; font-family:'Rency','Google Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;">

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f5f3f0; padding:40px 16px;">
  <tr>
    <td align="center">
      <table role="presentation" class="email-container" cellpadding="0" cellspacing="0" style="max-width:600px; width:100%; background:#ffffff; border-radius:12px; border:1px solid #e8e3db;">

        <!-- HEADER: only the detailed Hive SVG logo -->
        <tr>
          <td class="header" style="padding:28px 36px 16px; border-bottom:1px solid #f0ece4;">
            <svg class="logo-svg" width="48" height="48" viewBox="0 0 363.79 363.79" xmlns="http://www.w3.org/2000/svg" style="display:inline-block; vertical-align:middle;">
              <rect width="363.79" height="363.79" fill="#feb307"/>
