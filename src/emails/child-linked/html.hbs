<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Child linked</title>
  <style>
    @media screen {
      @font-face {
        font-family: 'Rency';
        src: url('https://cdn.cowrywise.com/fonts/rency/rency.woff2') format('woff2');
        font-weight: normal;
        font-display: fallback;
      }
      @font-face {
        font-family: 'Rency';
        src: url('https://cdn.cowrywise.com/fonts/rency/rency.woff2') format('woff2');
        font-weight: 600;
        font-display: fallback;
      }
    }
    body {
      margin: 0;
      padding: 0;
      background-color: #f5f3f0;
      font-family: 'Rency', 'Google Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    .email-container {
      max-width: 600px;
      margin: 0 auto;
      background: #ffffff;
      border-radius: 12px;
      border: 1px solid #e8e3db;
    }
    .header {
      padding: 28px 36px 16px;
      border-bottom: 1px solid #f0ece4;
    }
    .logo-svg {
      display: inline-block;
      vertical-align: middle;
      width: 48px;
      height: 48px;
    }
    .content {
      padding: 32px 36px 28px;
    }
    .badge {
      font-size: 11px;
      font-weight: 600;
      color: #a09888;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      margin: 0 0 4px;
    }
    .greeting {
      font-size: 20px;
      font-weight: 400;
      color: #3D3522;
      margin: 0 0 16px;
      line-height: 1.4;
    }
    .message {
      font-size: 14px;
      line-height: 1.8;
      color: #6b6255;
      margin: 0 0 24px;
    }
    .message strong {
      color: #3D3522;
    }
    .details {
      border-top: 1px solid #f0ece4;
      padding-top: 24px;
      margin-top: 24px;
    }
    .detail-row {
      margin-bottom: 16px;
    }
    .detail-label {
      font-size: 13px;
      color: #a09888;
      margin: 0 0 4px;
    }
    .detail-value {
      font-size: 15px;
      color: #3D3522;
      font-weight: 500;
      margin: 0;
    }
    .detail-value.pending {
      color: #a09888;
    }
    .detail-value .status-pending {
      color: #a09888;
    }
    .cta-wrapper {
      margin-top: 28px;
    }
    .cta-button {
      display: inline-block;
      background-color: #000000;
      color: #ffffff;
      font-size: 15px;
      font-weight: 500;
      text-decoration: none;
      padding: 14px 40px;
      border-radius: 8px;
      letter-spacing: 0.3px;
    }
    .footer {
      background: #faf9f7;
      border-top: 1px solid #e8e3db;
      border-radius: 0 0 12px 12px;
      padding: 20px 36px 24px;
      font-size: 12px;
      color: #a09888;
      line-height: 1.6;
      text-align: left;
    }
    @media (max-width: 480px) {
      .header, .content, .footer {
        padding-left: 20px;
        padding-right: 20px;
      }
    }
  </style>
</head>
<body style="margin:0; padding:0; background-color:#f5f3f0; font-family:'Rency','Google Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;">

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f5f3f0; padding:40px 16px;">
  <tr>
    <td align="center">
      <table role="presentation" class="email-container" cellpadding="0" cellspacing="0" style="max-width:600px; width:100%; background:#ffffff; border-radius:12px; border:1px solid #e8e3db;">

        <!-- HEADER: only the detailed Hive SVG logo -->
        <tr>
          <td class="header" style="padding:28px 36px 16px; border-bottom:1px solid #f0ece4;">
            <img class="logo-svg" src="https://cdn.tryhive.app/assets/logos/logo.png" width="48" height="48" alt="Hive" style="display:inline-block; vertical-align:middle; border:0;">
          </td>
        </tr>

        <!-- CONTENT -->
        <tr>
          <td class="content" style="padding:32px 36px 28px;">

            <p class="badge" style="font-size:11px; font-weight:600; color:#a09888; letter-spacing:1.5px; text-transform:uppercase; margin:0 0 4px;">
              {{#if isActive}}Link confirmed{{else}}Invite sent{{/if}}
            </p>

            <p class="greeting" style="font-size:20px; font-weight:400; color:#3D3522; margin:0 0 16px; line-height:1.4;">
              Hello {{parentName}}
            </p>

            <p class="message" style="font-size:14px; line-height:1.8; color:#6b6255; margin:0 0 24px;">
              {{#if isActive}}
                Your child <strong style="color:#3D3522;">{{childName}}</strong> has been linked to your account. You can now monitor their progress, enrolled courses, and learning activity from your dashboard.
              {{else}}
                An invitation has been sent to <strong style="color:#3D3522;">{{childEmail}}</strong>. Once they create their Hive account, the link will activate automatically and you will be able to monitor their progress.
              {{/if}}
            </p>

            <!-- Details -->
            <div class="details" style="border-top:1px solid #f0ece4; padding-top:24px; margin-top:24px;">
              {{#if isActive}}
                <div class="detail-row" style="margin-bottom:16px;">
                  <p class="detail-label" style="font-size:13px; color:#a09888; margin:0 0 4px;">Child</p>
                  <p class="detail-value" style="font-size:15px; color:#3D3522; font-weight:500; margin:0;">
                    {{childName}} · {{childEmail}}
                  </p>
                </div>
                <div class="detail-row" style="margin-bottom:0;">
                  <p class="detail-label" style="font-size:13px; color:#a09888; margin:0 0 4px;">Linked on</p>
                  <p class="detail-value" style="font-size:15px; color:#3D3522; font-weight:500; margin:0;">
                    {{linkedAt}}
                  </p>
                </div>
              {{else}}
                <div class="detail-row" style="margin-bottom:16px;">
                  <p class="detail-label" style="font-size:13px; color:#a09888; margin:0 0 4px;">Invited email</p>
                  <p class="detail-value" style="font-size:15px; color:#3D3522; font-weight:500; margin:0;">
                    {{childEmail}}
                  </p>
                </div>
                <div class="detail-row" style="margin-bottom:0;">
                  <p class="detail-label" style="font-size:13px; color:#a09888; margin:0 0 4px;">Status</p>
                  <p class="detail-value pending" style="font-size:15px; color:#a09888; font-weight:500; margin:0;">
                    Pending – waiting for {{childEmail}} to join
                  </p>
                </div>
              {{/if}}
            </div>

            <!-- CTA -->
            <div class="cta-wrapper" style="margin-top:28px;">
              <a href="{{dashboardUrl}}" class="cta-button" style="display:inline-block; background-color:#000000; color:#ffffff; font-size:15px; font-weight:500; text-decoration:none; padding:14px 40px; border-radius:8px; letter-spacing:0.3px;">
                View dashboard
              </a>
            </div>

          </td>
        </tr>

        <!-- FOOTER -->
        <tr>
          <td class="footer" style="background:#faf9f7; border-top:1px solid #e8e3db; border-radius:0 0 12px 12px; padding:20px 36px 24px; font-size:12px; color:#a09888; line-height:1.6; text-align:left;">
            Learn together, grow together.
          </td>
        </tr>

      </table>
    </td>
  </tr>
</table>

</body>
</html>
