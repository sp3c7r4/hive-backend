<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="light dark">
  <meta name="supported-color-schemes" content="light dark">
  <title>Trial Ended</title>
</head>
<body style="margin: 0; padding: 0; background-color: #0f0f0f; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; -webkit-font-smoothing: antialiased;">

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #0f0f0f;">
    <tr>
      <td align="center" style="padding: 40px 16px;">

        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width: 480px;">

          <!-- Body -->
          <tr>
            <td style="background: #1a1a1a; border: 1px solid #2a2a2a; border-radius: 16px 16px 0 0; padding: 40px 40px 0;">
              <p style="margin: 0 0 24px; font-size: 22px; font-weight: 300; color: #ffffff; line-height: 1.4;">
                Your trial for {{businessName}} has ended &#x23F0;
              </p>
              <p style="margin: 0 0 24px; font-size: 14px; line-height: 1.8; color: #999999;">
                Your 30-day free trial has come to an end. Your bots have been paused and will no longer respond to customers until you upgrade to a paid plan.
              </p>
            </td>
          </tr>

          <!-- What Happens Next -->
          <tr>
            <td style="background: #1a1a1a; border-left: 1px solid #2a2a2a; border-right: 1px solid #2a2a2a; padding: 0 40px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td style="border-top: 1px solid #2a2a2a; padding: 28px 0 0;">
                    <p style="margin: 0 0 20px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: #444444;">
                      &#x1F4CB; What happens now
                    </p>
                  </td>
                </tr>
              </table>

              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-bottom: 20px;">
                <tr>
                  <td width="36" valign="top">
                    <table role="presentation" cellpadding="0" cellspacing="0">
                      <tr>
                        <td style="background-color: #DB1D6A; border-radius: 8px; width: 28px; height: 28px; text-align: center; font-size: 13px; font-weight: 700; color: #ffffff; line-height: 28px;">
                          1
                        </td>
                      </tr>
                    </table>
                  </td>
                  <td style="padding-left: 12px;">
                    <p style="margin: 0 0 2px; font-size: 14px; font-weight: 600; color: #ffffff;">Your bots are paused</p>
                    <p style="margin: 0; font-size: 13px; color: #666666; line-height: 1.6;">Customers won't receive responses until you upgrade.</p>
                  </td>
                </tr>
              </table>

              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-bottom: 20px;">
                <tr>
                  <td width="36" valign="top">
                    <table role="presentation" cellpadding="0" cellspacing="0">
                      <tr>
                        <td style="background-color: #DB1D6A; border-radius: 8px; width: 28px; height: 28px; text-align: center; font-size: 13px; font-weight: 700; color: #ffffff; line-height: 28px;">
                          2
                        </td>
                      </tr>
                    </table>
                  </td>
                  <td style="padding-left: 12px;">
                    <p style="margin: 0 0 2px; font-size: 14px; font-weight: 600; color: #ffffff;">Pick a plan that fits</p>
                    <p style="margin: 0; font-size: 13px; color: #666666; line-height: 1.6;">Starter (&#8358;15,000/mo), Growth (&#8358;35,000/mo), or Enterprise.</p>
                  </td>
                </tr>
              </table>

              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-bottom: 8px;">
                <tr>
                  <td width="36" valign="top">
                    <table role="presentation" cellpadding="0" cellspacing="0">
                      <tr>
                        <td style="background-color: #DB1D6A; border-radius: 8px; width: 28px; height: 28px; text-align: center; font-size: 13px; font-weight: 700; color: #ffffff; line-height: 28px;">
                          3
                        </td>
                      </tr>
                    </table>
                  </td>
                  <td style="padding-left: 12px;">
                    <p style="margin: 0 0 2px; font-size: 14px; font-weight: 600; color: #ffffff;">Bots resume automatically</p>
                    <p style="margin: 0; font-size: 13px; color: #666666; line-height: 1.6;">Once you upgrade, your bots go live again &mdash; no extra setup needed.</p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- CTA -->
          <tr>
            <td style="background: #1a1a1a; border-left: 1px solid #2a2a2a; border-right: 1px solid #2a2a2a; padding: 28px 40px 0;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td style="border-top: 1px solid #2a2a2a; padding: 28px 0 0; text-align: center;">
                    <table role="presentation" cellpadding="0" cellspacing="0" align="center">
                      <tr>
                        <td style="background-color: #DB1D6A; border-radius: 10px; padding: 14px 36px;">
                          <a href="{{dashboardUrl}}" style="font-size: 14px; font-weight: 600; color: #ffffff; text-decoration: none; display: inline-block;">
                            Upgrade Now &rarr;
                          </a>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Closing -->
          <tr>
            <td style="background: #1a1a1a; border: 1px solid #2a2a2a; border-top: none; border-radius: 0 0 16px 16px; padding: 28px 40px 36px;">
              <p style="margin: 0; font-size: 14px; line-height: 1.7; color: #999999;">
                Need help choosing a plan? Just reply to this email &mdash; we're happy to help.
              </p>
              <p style="margin: 20px 0 0; font-size: 14px; color: #666666;">
                Cheers,<br />
                <span style="color: #DB1D6A; font-weight: 600;">The Bloom Team</span>
              </p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding: 32px 40px; text-align: center;">
              <p style="margin: 0 0 8px; font-size: 12px; color: #444444;">
                &copy; 2026 Bloom &middot; All rights reserved
              </p>
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>
