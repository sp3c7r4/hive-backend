<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Welcome</title>
  <style>
    @media screen {
      @font-face {
        font-family: 'Rency';
        src: url('https://cdn.cowrywise.com/fonts/rency/rency.woff2') format('woff2');
        font-weight: normal;
        font-display: fallback;
      }
      @font-face {
        font-family: 'Rency';
        src: url('https://cdn.cowrywise.com/fonts/rency/rency.woff2') format('woff2');
        font-weight: 600;
        font-display: fallback;
      }
    }
    body {
      margin: 0;
      padding: 0;
      background-color: #f5f3f0;
      font-family: 'Rency', 'Google Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    .email-container {
      max-width: 600px;
      margin: 0 auto;
      background: #ffffff;
      border-radius: 12px;
      border: 1px solid #e8e3db;
    }
    .header {
      padding: 28px 36px 16px;
      border-bottom: 1px solid #f0ece4;
    }
    .logo-svg {
      display: inline-block;
      vertical-align: middle;
      width: 48px;
      height: 48px;
    }
    .content {
      padding: 32px 36px 28px;
    }
    .greeting {
      font-size: 22px;
      font-weight: 500;
      color: #3D3522;
      margin: 0 0 16px;
    }
    .subtext {
      font-size: 14px;
      line-height: 1.8;
      color: #6b6255;
      margin: 0 0 24px;
    }
    .steps {
      border-top: 1px solid #f0ece4;
      padding-top: 24px;
      margin-top: 24px;
    }
    .steps-label {
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      color: #a09888;
      margin: 0 0 18px;
    }
    .step {
      margin-bottom: 16px;
      font-size: 14px;
      color: #3D3522;
      line-height: 1.6;
    }
    .step-number {
      display: inline-block;
      background-color: #faf9f7;
      border: 1px solid #e8e3db;
      border-radius: 6px;
      width: 24px;
      height: 24px;
      text-align: center;
      font-size: 12px;
      font-weight: 600;
      color: #3D3522;
      line-height: 24px;
      margin-right: 12px;
    }
    .cta-button {
      display: inline-block;
      background-color: #000000;
      color: #ffffff;
      font-size: 15px;
      font-weight: 500;
      text-decoration: none;
      padding: 14px 40px;
      border-radius: 8px;
      letter-spacing: 0.3px;
      margin: 20px 0 0;
    }
    .footer {
      background: #faf9f7;
      border-top: 1px solid #e8e3db;
      border-radius: 0 0 12px 12px;
      padding: 20px 36px 24px;
      font-size: 12px;
      color: #a09888;
      line-height: 1.6;
    }
    @media (max-width: 480px) {
      .header, .content, .footer {
        padding-left: 20px;
        padding-right: 20px;
      }
    }
  </style>
</head>
<body style="margin:0; padding:0; background-color:#f5f3f0; font-family:'Rency','Google Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;">

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f5f3f0; padding:40px 16px;">
  <tr>
    <td align="center">
      <table role="presentation" class="email-container" cellpadding="0" cellspacing="0" style="max-width:600px; width:100%; background:#ffffff; border-radius:12px; border:1px solid #e8e3db;">
        <!-- HEADER: only SVG logo -->
        <tr>
          <td class="header" style="padding:28px 36px 16px; border-bottom:1px solid #f0ece4;">
            <img class="logo-svg" src="https://cdn.tryhive.app/assets/logos/logo.png" width="48" height="48" alt="Hive" style="display:inline-block; vertical-align:middle; border:0;">
          </td>
        </tr>
        <!-- CONTENT -->
        <tr>
          <td class="content" style="padding:32px 36px 28px;">
            <p class="greeting" style="font-size:22px; font-weight:500; color:#3D3522; margin:0 0 16px;">Welcome, {{name}}</p>
            <p class="subtext" style="font-size:14px; line-height:1.8; color:#6b6255; margin:0 0 24px;">
              Your account is ready. You can now connect with instructors, students and parents – all in one place.
            </p>

            <div class="steps" style="border-top:1px solid #f0ece4; padding-top:24px; margin-top:24px;">
              <p class="steps-label" style="font-size:11px; font-weight:600; text-transform:uppercase; letter-spacing:1.5px; color:#a09888; margin:0 0 18px;">Getting started</p>

              <div class="step" style="margin-bottom:16px; font-size:14px; color:#3D3522; line-height:1.6;">
                <span class="step-number" style="display:inline-block; background-color:#faf9f7; border:1px solid #e8e3db; border-radius:6px; width:24px; height:24px; text-align:center; font-size:12px; font-weight:600; color:#3D3522; line-height:24px; margin-right:12px;">1</span>
                Complete your profile – add a photo and bio
              </div>

              <div class="step" style="margin-bottom:16px; font-size:14px; color:#3D3522; line-height:1.6;">
                <span class="step-number" style="display:inline-block; background-color:#faf9f7; border:1px solid #e8e3db; border-radius:6px; width:24px; height:24px; text-align:center; font-size:12px; font-weight:600; color:#3D3522; line-height:24px; margin-right:12px;">2</span>
                Browse communities and courses that match your interests
              </div>

              <div class="step" style="margin-bottom:16px; font-size:14px; color:#3D3522; line-height:1.6;">
                <span class="step-number" style="display:inline-block; background-color:#faf9f7; border:1px solid #e8e3db; border-radius:6px; width:24px; height:24px; text-align:center; font-size:12px; font-weight:600; color:#3D3522; line-height:24px; margin-right:12px;">3</span>
                Enrol and start learning at your own pace
              </div>

              <div style="margin-top:24px;">
                <a href="{{dashboardUrl}}" class="cta-button" style="display:inline-block; background-color:#000000; color:#ffffff; font-size:15px; font-weight:500; text-decoration:none; padding:14px 40px; border-radius:8px; letter-spacing:0.3px;">Go to dashboard</a>
              </div>
            </div>
          </td>
        </tr>
        <!-- FOOTER -->
        <tr>
          <td class="footer" style="background:#faf9f7; border-top:1px solid #e8e3db; border-radius:0 0 12px 12px; padding:20px 36px 24px; font-size:12px; color:#a09888; line-height:1.6;">
            Learn together, grow together.
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>

</body>
</html>
