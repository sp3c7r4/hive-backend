<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>{{courseTitle}} - Certificate</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,340;0,9..144,500;0,9..144,600;1,9..144,500&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --amber: #FEB307;
    --ink: #050403;
    --paper: #FEFEFE;
    --ink-soft: rgba(5, 4, 3, 0.55);
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html, body {
    width: 1123px;
    height: 794px;
    background: var(--paper);
    font-family: 'Manrope', sans-serif;
    color: var(--ink);
    -webkit-font-smoothing: antialiased;
  }

  .sheet {
    width: 1123px;
    height: 794px;
    background: var(--paper);
    padding: 64px 88px;
    display: flex;
    flex-direction: column;
  }

  /* ---------- header ---------- */

  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .brand-mark {
    width: 40px;
    height: 40px;
    border-radius: 9px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .brand-mark img,
  .brand-mark svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .brand-name {
    font-family: 'Fraunces', serif;
    font-weight: 500;
    font-size: 20px;
  }

  .header-meta {
    text-align: right;
  }

  .header-meta-row {
    font-size: 13px;
    color: var(--ink-soft);
  }

  .header-meta-row strong {
    color: var(--ink);
    font-weight: 600;
  }

  /* ---------- body ---------- */

  .body {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    max-width: 700px;
  }

  .lede {
    font-size: 16px;
    color: var(--ink-soft);
  }

  .student-name {
    font-family: 'Fraunces', serif;
    font-weight: 600;
    font-size: 56px;
    line-height: 1.1;
    margin-top: 10px;
  }

  .badge {
    display: none;
    margin-top: 16px;
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--amber);
    color: var(--ink);
    font-size: 13px;
    font-weight: 700;
  }

  .badge-distinction { display: inline-block; }

  .course-lede {
    font-size: 16px;
    color: var(--ink-soft);
    margin-top: 34px;
  }

  .course-title {
    font-family: 'Fraunces', serif;
    font-weight: 500;
    font-size: 28px;
    line-height: 1.3;
    margin-top: 6px;
  }

  .detail-line {
    font-size: 15px;
    color: var(--ink-soft);
    margin-top: 12px;
  }

  /* ---------- footer ---------- */

  .footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
  }

  .signee {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .signee-mark {
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-weight: 500;
    font-size: 24px;
  }

  .signee-name {
    font-size: 13.5px;
    font-weight: 700;
  }

  .signee-role {
    font-size: 12.5px;
    color: var(--ink-soft);
  }

  .footer-right {
    text-align: right;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .footer-right-label {
    font-size: 12.5px;
    color: var(--ink-soft);
  }

  .footer-right-value {
    font-size: 13.5px;
    font-weight: 600;
  }
</style>
</head>
<body>
  <div class="sheet">

    <div class="header">
      <div class="brand">
        <div class="brand-mark">
          {{#if logoUrl}}
          <img src="{{logoUrl}}" alt="{{issuerName}} logo">
          {{else}}
