            <path fill="#050403" d="M261.85,92.28a73,73,0,0,0-75.13,66.22c-1.5.67-6.08.26-6.95-.36-1-38-30.8-69.49-68.5-70.91a72.4,72.4,0,0,0-5.5,144.69c36.94,1.26,69-26.68,73.47-63.11a28.28,28.28,0,0,1,7.24,0c1.69,37.19,28.37,67.94,65.88,69.33,39.89,1.47,76.56-29.6,78.2-69.52C332.35,128.18,301.59,93.94,261.85,92.28Zm-91.16,70c-1.28,34.39-30.57,61.61-64.62,60.46a63.25,63.25,0,0,1,4.81-126.41C145.11,97.66,171.91,127.31,170.69,162.32Zm150.2,5.88a62.57,62.57,0,0,1-64.79,60.18c-34.39-1.28-61.52-31-60-65.76a63.17,63.17,0,0,1,65.25-60.54C295.8,103.51,322.44,133.16,320.89,168.2Z"/>
          </svg>
          {{/if}}
        </div>
        <span class="brand-name">{{issuerName}}</span>
      </div>

      <div class="header-meta">
        <p class="header-meta-row">Certificate <strong>{{certificateId}}</strong></p>
        <p class="header-meta-row">Issued <strong>{{completionDate}}</strong></p>
      </div>
    </div>

    <div class="body">
      <p class="lede">This certifies that</p>
      <h1 class="student-name">{{studentName}}</h1>

      {{#if gradeVariant}}
      <span class="badge badge-{{gradeVariant}}">Completed with distinction</span>
      {{/if}}

      <p class="course-lede">has successfully completed the course</p>
      <h2 class="course-title">{{courseTitle}}</h2>

      {{#if courseLevel}}
      <p class="detail-line">{{courseLevel}} level{{#if courseCategory}} in {{courseCategory}}{{/if}}</p>
      {{else}}
        {{#if courseCategory}}
        <p class="detail-line">{{courseCategory}}</p>
        {{/if}}
      {{/if}}

      {{#if finalProgress}}
      <p class="detail-line">Completed with {{finalProgress}}{{#if quizScore}}, final quiz score {{quizScore}}{{/if}}</p>
      {{/if}}
    </div>

    <div class="footer">
      <div class="signee">
        <span class="signee-mark">{{instructorName}}</span>
        <span class="signee-name">{{instructorName}}</span>
        {{#if instructorTitle}}
        <span class="signee-role">{{instructorTitle}}</span>
        {{else}}
        <span class="signee-role">Course instructor</span>
        {{/if}}
      </div>

      <div class="footer-right">
        {{#if communityName}}
        <p class="header-meta-row">{{communityName}}</p>
        {{/if}}
        <p class="footer-right-label">Verify at</p>
        <p class="footer-right-value">{{verificationUrl}}</p>
      </div>
    </div>

  </div>
</body>
</html>
