<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Hive Certificate</title>
    <style>
        @font-face {
            font-family: 'Fraunces';
            font-style: normal;
            font-weight: 400;
            src: url(data:font/woff2;base64,) format('woff2');
        }
        @font-face {
            font-family: 'Fraunces';
            font-style: normal;
            font-weight: 600;
            src: url(data:font/woff2;base64,) format('woff2');
        }
        @font-face {
            font-family: 'Fraunces';
            font-style: normal;
            font-weight: 700;
            src: url(data:font/woff2;base64,) format('woff2');
        }
        @font-face {
            font-family: 'Fraunces';
            font-style: normal;
            font-weight: 900;
            src: url(data:font/woff2;base64,) format('woff2');
        }

        /* Satoshi is loaded from Fontshare's CDN (free, no self-host license needed). */
        @import url('https://api.fontshare.com/v2/css?f[]=satoshi@400,500,700&display=swap');

        :root {
            --gold: #c7a65b;
            --gray: #9e9e9e;
            --ink: #050403;
            --cream: #fefdfb;
        }

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            background: #e9e6df;
        }

        .cert-page {
            width: 1484px;
            height: 1060px;
            position: relative;
            margin: 0 auto;
            background-image: url('https://cdn.tryhive.app/assets/images/cert-assets/background.png');
            background-size: cover;
            background-repeat: no-repeat;
            background-color: var(--cream);
            font-family: 'Satoshi', 'Fraunces', sans-serif;
            overflow: hidden;
        }

        .serif {
            font-family: 'Fraunces', serif;
        }
        .sans {
            font-family: 'Satoshi', sans-serif;
        }

        /* ---------- Logo (top-left) ---------- */
        .logo {
            position: absolute;
            top: 150px;
            left: 142px;
            display: flex;
            align-items: center;
            gap: 16px;
        }
        .logo img {
            width: 100px;
            height: 87px;
            display: block;
            object-fit: contain;
            flex-shrink: 0;
        }
        .logo .wordmark {
            font-family: 'Fraunces', serif;
            font-weight: 700;
            font-size: 53.1375px;
            color: var(--ink);
            line-height: 1;
        }
        .logo .tagline {
            font-family: 'Satoshi', sans-serif;
            font-weight: 500;
            font-size: 22.9589px;
            color: #3a3a3a;
            margin-top: 2px;
        }

        /* ---------- Certificate ID / Issued (top-right) ---------- */
        .meta {
            position: absolute;
            top: 158px;
            right: 118px;
            max-width: 480px;
            text-align: right;
            font-size: 21.9429px;
            line-height: 36px;
            font-family: 'Satoshi', sans-serif;
            overflow-wrap: break-word;
        }
        .meta .label {
            color: var(--gray);
            font-weight: 500;
        }
        .meta .value {
            color: var(--ink);
            font-weight: 700;
            margin-left: 6px;
        }

        /* ---------- Center content ---------- */
        .intro {
            position: absolute;
            top: 292px;
            left: 0;
            right: 0;
            text-align: center;
            font-family: 'Satoshi', sans-serif;
            font-weight: 500;
            font-size: 22.9589px;
            letter-spacing: 0.02em;
            color: var(--gray);
        }

        .student-name {
            position: absolute;
            top: 340px;
            left: 60px;
            right: 60px;
            text-align: center;
            font-family: 'Fraunces', serif;
            font-weight: 700;
            font-size: 98.4127px;
            color: #0e0e0d;
            line-height: 1.15;
            white-space: normal;
            overflow-wrap: break-word;
        }

        .divider {
            position: absolute;
            top: 464px;
            left: 50%;
            transform: translateX(-50%);
            width: 369px;
            height: 42px;
        }

        .course-intro {
            position: absolute;
            top: 517px;
            left: 0;
            right: 0;
            text-align: center;
            font-family: 'Satoshi', sans-serif;
            font-weight: 500;
            font-size: 22.9589px;
            color: var(--gray);
        }

        .course-name {
            position: absolute;
            top: 560px;
            left: 100px;
            right: 100px;
            text-align: center;
            font-family: 'Fraunces', serif;
            font-weight: 600;
            font-size: 54.0726px;
            line-height: 1.2;
            color: #0e0e0d;
            white-space: normal;
            overflow-wrap: break-word;
        }

        /* ---------- Seal ---------- */
        .seal {
            position: absolute;
            top: 648px;
            left: 50%;
            transform: translateX(-50%);
            width: 303px;
            height: 259px;
            object-fit: contain;
        }

        /* ---------- Signature blocks ---------- */
        .sig-block {
            position: absolute;
            top: 668px;
            width: 380px;
            text-align: center;
            overflow: visible;
        }
        .sig-block.left {
            left: 120px;
        }
        .sig-block.right {
            right: 120px;
        }

        .sig-block img.signature {
            display: block;
            height: 84px;
            width: auto;
            max-width: 100%;
            object-fit: contain;
            margin: 0 auto 6px;
        }

        .sig-line {
            position: relative;
            width: 230px;
            margin: 14px auto 16px;
            height: 1px;
            background: var(--gold);
        }
        .sig-line::before,
        .sig-line::after {
            content: "";
            position: absolute;
            top: 50%;
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--gold);
            transform: translateY(-50%);
        }
        .sig-line::before {
            left: -3px;
        }
        .sig-line::after {
            right: -3px;
        }

        .sig-name {
            font-family: 'Fraunces', serif;
            font-weight: 600;
            font-size: 26.8331px;
            line-height: 1.25;
            color: #0e0e0d;
            white-space: normal;
            overflow-wrap: break-word;
            padding: 0 6px;
        }
        .sig-title {
            font-family: 'Satoshi', sans-serif;
            font-weight: 500;
            font-size: 22.0464px;
            color: var(--gray);
            margin-top: 6px;
        }
    </style>
</head>

<body>

    <div class="cert-page">

        <!-- Logo -->
        <div class="logo">
            <img src="https://cdn.tryhive.app/assets/logos/logo.png" alt="Hive logo">
            <div>
                <div class="wordmark">Hive</div>
                <div class="tagline">Learn in Community</div>
            </div>
        </div>

        <!-- Certificate ID / Issued -->
        <div class="meta">
            <div><span class="label">Certificate</span><span class="value">{{certificateId}}</span></div>
            <div><span class="label">Issued</span><span class="value">{{issuedDate}}</span></div>
        </div>

        <!-- Intro -->
        <div class="intro">This certifies that</div>

        <!-- Student Name -->
        <div class="student-name">{{studentName}}</div>

        <!-- Divider -->
        <img class="divider" src="data:image/png;base64," alt="">

        <!-- Course Intro -->
        <div class="course-intro">has successfully completed the course</div>

        <!-- Course Name -->
        <div class="course-name">{{course}}</div>

        <!-- Seal (fixed: object-fit: contain ensures no clipping) -->
        <img class="seal" src="https://cdn.tryhive.app/assets/images/cert-assets/seal.png" alt="Official seal">

        <!-- Signatures -->
        <div class="sig-block left">
            {{#if courseInstructorSignature}}<img class="signature" src="{{courseInstructorSignature}}" alt="Course instructor signature">{{/if}}
            <div class="sig-line"></div>
            <div class="sig-name">{{courseInstructorName}}</div>
            <div class="sig-title">Course Instructor</div>
        </div>

        <div class="sig-block right">
            {{#if executiveDirectorSignature}}<img class="signature" src="{{executiveDirectorSignature}}" alt="Executive director signature">{{/if}}
            <div class="sig-line"></div>
            <div class="sig-name">{{executiveDirectorName}}</div>
            <div class="sig-title">Executive Director</div>
        </div>

    </div>

</body>
</html>
